# ---------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Render / Production)
# ---------------------------------------------------------

# Server configuration
PORT=5000
NODE_ENV=production

# MongoDB configuration
# Connection string from MongoDB Atlas (e.g., mongodb+srv://<user>:<pass>@cluster.mongodb.net/...)
MONGODB_URI=

# Admin Authentication
ADMIN_USERNAME=admin
# Generate hash using: node -e "require('bcryptjs').hash('your_password', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=
# Generate a strong random string for JWT signing
JWT_SECRET=

# Email configuration (Gmail SMTP)
# Use a 16-character Google App Password (not your main Gmail password)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=
EMAIL_TO=where_to_receive_contacts@gmail.com

# CORS Configuration
# Set this to your production Vercel domain to restrict API access
FRONTEND_URL=https://your-portfolio-domain.vercel.app
